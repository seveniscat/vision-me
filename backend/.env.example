# 百炼 / DashScope API Key（必须）
# 获取: https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-xxx

# 视觉模型（推荐使用最强的视觉模型）
# 常用：qwen-vl-max-latest、qwen2.5-vl-72b-instruct
QWEN_VL_MODEL=qwen-vl-max-latest

# 服务端口
PORT=3001

# ==================== 严格两阶段技术方案推荐参数 ====================

# 阶段一瓦片大小（推荐 1536）
TILE_SIZE=1536

# 阶段一重叠比例（技术方案要求 0.45）
# 实际重叠像素 = TILE_SIZE * OVERLAP_RATIO
OVERLAP_RATIO=0.45

# 阶段二外扩上下文像素（技术方案要求 50）
CONTEXT_PADDING=50

# 并发控制（建议 1~3，保护限流和成本）
MAX_CONCURRENCY=2

# ==================== 图片上传（公司签名上传服务，用于 /api/upload）====================
# 两步式签名上传：GET /upload/token → POST /upload/single → 文件名拼 API_UPLOAD_HOST/file/
# 未配置时 /api/upload 会返回 500「上传服务未配置」，其余功能不受影响。
# 以下为测试环境示例值；生产环境替换为正式地址与完整密钥。
API_UPLOAD=http://test-upload.test.ptevent.cn/v0
API_UPLOAD_APPID=1008
API_UPLOAD_SECRET=
API_UPLOAD_HOST=https://file-oss.putaocdn.com

