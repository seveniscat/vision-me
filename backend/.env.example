# 百炼 / DashScope API Key（必须）
# 获取: https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-xxx

# 视觉模型（推荐使用最强的视觉模型）
# 常用：qwen-vl-max-latest、qwen2.5-vl-72b-instruct
QWEN_VL_MODEL=qwen-vl-max-latest

# 服务端口
PORT=3001

# ==================== 严格两阶段技术方案推荐参数 ====================

# 阶段一瓦片大小（推荐 1536）
TILE_SIZE=1536

# 阶段一重叠比例（技术方案要求 0.45）
# 实际重叠像素 = TILE_SIZE * OVERLAP_RATIO
OVERLAP_RATIO=0.45

# 阶段二外扩上下文像素（技术方案要求 50）
CONTEXT_PADDING=50

# 并发控制（建议 1~3，保护限流和成本）
MAX_CONCURRENCY=2

# ==================== OSS 图片上传（可选，用于 /api/upload） ====================
# 阿里云 OSS：把图片传到对象存储并返回可访问 URL。
# 未配置时 /api/upload 会返回 500「OSS 未配置」，其余功能不受影响。
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET=your-bucket-name
# OSS_ENDPOINT=                       # 可选，自定义域名/内网/CDN endpoint

